# Servidor do site no Railway. Substitui o padrão do Railpack, cuja política de segurança
# (CSP) bloqueia a biblioteca que monta o Word e a prévia das fotos enviadas (blob:).
{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:80} {
	log {
		format json
	}
	respond /health 200

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	root * /app
	encode gzip
	file_server
	try_files {path} /index.html
}
